{
  "languages": {
    "CSS": {
      "prettier": { "allowed": true },
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "HTML": {
      "prettier": { "allowed": true },
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "JavaScript": {
      "prettier": { "allowed": true },
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
      "format_on_save": "on"
    },
    "TypeScript": {
      "prettier": { "allowed": true },
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
      "format_on_save": "on"
    },
    "TSX": {
      "prettier": { "allowed": true },
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
      "format_on_save": "on"
    },
    "Svelte": {
      "prettier": { "allowed": true },
      "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"],
      "format_on_save": "on"
    },
    "JSON": {
      "prettier": { "allowed": true },
      "formatter": "prettier",
      "format_on_save": "on"
    },
    "JSONC": {
      "prettier": { "allowed": true },
      "formatter": "prettier",
      "format_on_save": "on"
    }
  },
  "lsp": {
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
          }
        }
      }
    },
    "eslint": {
      "settings": {
        "useFlatConfig": true,
        "workingDirectories": [{ "mode": "auto" }],
        "codeActionOnSave": {
          "enable": true,
          "mode": "all"
        }
      }
    }
  }
}

    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@portabletext/svelte": "^3.0.1",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lightningcss": "^1.33.0",
    "pdfjs-dist": "^5.7.284",
    "svelte-fa": "^4.0.4"
  }
